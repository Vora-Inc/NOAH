{
  "convention": {
    "fp_scale": "1000000000",
    "rounding": "floor at every division",
    "harshness": "integer 1..8 or the string 'cliff'",
    "cliff_semantics": "below target 0; at or above target exactly FP_SCALE; the cap is ignored at the cliff",
    "source": "docs/standard.md"
  },
  "multiplier_vectors": [
    {
      "name": "std_doc_miner_A_full",
      "pci": "800000000",
      "target": "800000000",
      "harshness": 1,
      "cap": "1000000000",
      "expected_multiplier": "1000000000"
    },
    {
      "name": "std_doc_miner_B_gentle",
      "pci": "600000000",
      "target": "800000000",
      "harshness": 1,
      "cap": "1000000000",
