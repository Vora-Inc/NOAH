# MAINNET (Bittensor finney, subnet 82) validator settings. Copy to .env.validator
# on the mainnet host and fill in every REPLACE-ME. Never commit a filled copy.
#
# Mainnet starts ONLY when every condition in noah/core/mainnet.py holds; a startup
# that misses any of them prints each one and does not connect further. A line
# still containing REPLACE-ME is itself refused.
#
# Public addresses are recorded in docs/reference/WALLET_ADDRESSES.md.
# No key material of any kind belongs in this file.

NOAH_NETWORK=finney
NOAH_NETUID=82

# The deliberate switch. Exactly mainnet's genesis hash; a stale or copied env
# cannot enable mainnet by accident. Each endpoint below must report this too.
NOAH_MAINNET_ENABLE=0x2f0555cc76fc2840a25a6ea3b9637146806f1f44b090c175ffde2a7e5ab36c03

# Two INDEPENDENT endpoints, both read-capable and both on mainnet. The primary is
# also the client the gate reads through, so it must keep >= 3 days (21,600 blocks)
# of state. Use independently operated nodes and verify genesis and capabilities.
NOAH_CHAIN_ENDPOINT=REPLACE-ME
NOAH_ENDPOINT_2=REPLACE-ME
# Optional instead of NOAH_ENDPOINT_2 (set only one): a file whose content is the
# second endpoint URL, for a URL that contains an access key. The file should be
# mode 600 and owned by the service user.
# NOAH_ENDPOINT_2_FILE=/path/to/endpoint-2-url

# Where the signed commit is SUBMITTED. Needs an endpoint that allows
# author_submitExtrinsic. Leave EMPTY to submit through NOAH_CHAIN_ENDPOINT.
# If set, it must report the mainnet genesis too.
NOAH_SUBMIT_ENDPOINT=

# Selected Null policy: direct weights through the configured proxy.
# The subnet must have commit-reveal disabled and the configured publisher must hold a permit.
NOAH_PUBLISH_MODE=direct

# Wallet NAME and hotkey NAME on the host (names only, never keys). The loaded
# hotkey must match NOAH_PROXY_SIGNER_ADDRESS, the operational signer below.
NOAH_WALLET_NAME=REPLACE-ME
NOAH_WALLET_HOTKEY=REPLACE-ME
# Public ss58 of YOUR registered publishing hotkey, not the Ark deposit hotkey.
# Null elects one highest-stake UID; this setting does not grant its permit.
NOAH_EXPECTED_SIGNER_ADDRESS=REPLACE-ME
# Public ss58 of the DEDICATED proxy signer: the key the unit loads. It signs and pays for
# Proxy.proxy(real = the address above); the validator's own key above is never loaded on a
# server. Replace the placeholder with the intended public signer address.
NOAH_PROXY_SIGNER_ADDRESS=REPLACE-ME

# Ark receiving coldkey: where miner deposits are received.
NOAH_ARK_ADDRESS=5EL1nNebm9e3iKBz3G8vELKYqYVWN4iyda8a79esydKBsba3
# Ark Validator hotkey: the mandatory delegation destination.
NOAH_VALIDATOR_HOTKEY=5DLQGc9DoabXWGp4s4vktHyGEA3itg8twResPfDZ4qw8RZJV

# 10 NOAH entry deposit. Must equal the profile's entryDepositPerHotkeyRao.
NOAH_ENTRY_DEPOSIT_RAO=10000000000

# Profile: must be a DECIDED mainnet profile (profileVersion starts with "mainnet-production-").
# docs/parameters/profiles/mainnet-production-v1.json is that profile; the 50% target
# (500000000) comes from it.
NOAH_PARAMETERS_JSON=REPLACE-ME/docs/parameters/profiles/mainnet-production-v1.json
# Dials file with the same seven values as the profile; generate it, do not hand-edit:
#   python scripts/mainnet_dials_from_profile.py > <path>
NOAH_DIALS_JSON=REPLACE-ME/mainnet-dials.json

# State. Keep outside the source checkout so upgrades preserve it.
NOAH_RUNTIME_ROOT=REPLACE-ME
NOAH_COMMIT_LEDGER_PATH=REPLACE-ME/commit-ledger.json
NOAH_HISTORY_DB=REPLACE-ME/history.db

# Operational settings.
NOAH_LOG_LEVEL=info
NOAH_SCORE_INTERVAL_BLOCKS=360
NOAH_WEIGHT_INTERVAL_BLOCKS=360
NOAH_SETTLE_BLOCKS=20
NOAH_REQUIRE_TWIN_PROOF=true
NOAH_HOLDING_STRIDE_BLOCKS=300

# Optional epoch maintenance; disabled until reviewed and rehearsed.
# Daily scoring is unchanged. Republication requires direct mode.
# See docs/EPOCH_MAINTENANCE.md for receipts, recovery and rollback.
NOAH_EPOCH_COLLECTION=false
NOAH_EPOCH_REPUBLICATION=false
